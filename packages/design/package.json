{
  "name": "@repo/design",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./shadcn": "./src/shadcn/index.ts",
    "./shadcn/*": "./src/shadcn/*.tsx",
    "./components": "./src/components/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./swiper": "./src/swiper.ts",
    "./swiper/css": {
      "types": "./src/styles/swiper/index.d.ts",
      "default": "./src/styles/swiper/index.css"
    },
    "./swiper/css/*": {
      "types": "./src/styles/swiper/*.d.ts",
      "default": "./src/styles/swiper/*.css"
    },
    "./swiper.css": {
      "types": "./src/styles/swiper/index.d.ts",
      "default": "./src/styles/swiper/index.css"
    },
    "./fontawesome.css": {
      "types": "./src/styles/fontawesome.d.ts",
      "default": "./src/styles/fontawesome.css"
    },
    "./lucide": "./src/icons/lucide.ts",
    "./react-icons": "./src/icons/react-icons.ts",
    "./icons": "./src/icons/index.ts",
    "./icons/*": "./src/icons/*.ts",
    "./lenis": "./src/lenis.ts",
    "./lib/*": "./src/lib/*.ts",
    "./cn": "./src/lib/utils.ts",
    "./swiper/css/bundle": "./node_modules/swiper/swiper-bundle.css"
  },
  "scripts": {
    "lint": "eslint .",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.48.0",
    "react-hook-form": "^7.89.0",
    "react-icons": "^5.7.0",
    "swiper": "^14.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0-0 || ^19.3.0",
    "react-dom": "^18.3.1 || ^19.0.0-0 || ^19.3.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
